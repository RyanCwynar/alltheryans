{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": "."
  },
  "include": ["api/**/*.ts", "db/**/*.ts", "scripts/**/*.ts", "drizzle.config.ts"]
}
