{
  "rewrites": [
    { "source": "/ryan/:slug", "destination": "/index.html" },
    { "source": "/tag/:slug", "destination": "/tag/index.html" }
  ],
  "headers": [
    {
      "source": "/ryans/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
